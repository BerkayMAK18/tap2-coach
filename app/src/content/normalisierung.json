        {
          "nf": 3,
          "text": "Ort wandert mit der PLZ als Schlüssel in eine eigene Tabelle. In Kunde bleibt die PLZ als Fremdschlüssel.",
          "tabellen": [
            {
              "name": "Kunde",
              "spalten": [{ "n": "KundenNr", "pk": true }, { "n": "Name" }, { "n": "PLZ", "fk": "Ort" }],
              "zeilen": [["1", "Krause", "55116"], ["2", "Demir", "65183"], ["3", "Berg", "55116"]]
            },
            {
              "name": "Ort",
              "spalten": [{ "n": "PLZ", "pk": true }, { "n": "Ort" }],
