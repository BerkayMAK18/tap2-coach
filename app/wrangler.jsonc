// Cloudflare Workers (nur statische Dateien, kein Server-Code): liefert dist/ aus.
// Unbekannte Pfade → index.html (SPA). Sicherheits-Header kommen aus public/_headers.
// Build in Cloudflare: Root „app“, Build „npm run build“, Deploy „npx wrangler deploy“, Branch „dev“.
{
  "name": "tap2-coach-dev",
  "compatibility_date": "2025-09-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
